{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./pup-focus/*"]
    }
  },
  "include": [
    "clean-faculty-submission-panel.tsx",
    "pup-focus/next-env.d.ts"
  ],
  "exclude": ["node_modules", "pup-focus"]
}
